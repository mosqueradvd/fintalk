# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgresql://fintalk:fintalk@localhost:5432/fintalk

# Claude API key for the chat orchestrator (console.anthropic.com).
# Local dev uses a plain key; in cloud/CI, prefer workload identity federation.
ANTHROPIC_API_KEY=

# Optional: override the chat model (default: claude-haiku-4-5-20251001)
# CHAT_MODEL=claude-sonnet-5
